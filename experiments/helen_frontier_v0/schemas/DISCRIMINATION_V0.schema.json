{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helen://experiments/helen_frontier_v0/DISCRIMINATION_V0",
  "title": "DISCRIMINATION_V0",
  "description": "One unresolved discrimination D_i on the HELEN.FRONTIER frontier Q_t. Experimental object. Validates structure only: it proves nothing about semantic equivalence, contribution independence, or cognitive value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "distinction_id", "h_plus", "h_minus", "x_star",
    "e_plus", "e_minus", "witness", "status", "scope", "provenance", "authority"
  ],
  "properties": {
    "schema": { "const": "DISCRIMINATION_V0" },
    "distinction_id": {
      "type": "string",
      "pattern": "^D-[a-z0-9][a-z0-9._-]{2,63}$",
      "description": "Declared identity of the distinction. Equality of ids is declarative, not semantic."
    },
    "h_plus":  { "$ref": "#/$defs/nonEmptyText", "description": "Hypothesis H+." },
    "h_minus": { "$ref": "#/$defs/nonEmptyText", "description": "Competing hypothesis H-." },
    "x_star":  { "$ref": "#/$defs/nonEmptyText", "description": "The examination x* that could separate H+ from H-." },
    "e_plus":  { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "description": "Evidence favouring H+." },
    "e_minus": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" }, "description": "Evidence favouring H-." },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requirement"],
      "properties": {
        "kind": { "enum": ["replay", "receipt", "operator", "test", "external_source"] },
        "requirement": { "$ref": "#/$defs/nonEmptyText" }
      },
      "description": "Witness W required to qualify the result of x*."
    },
    "status": { "enum": ["OPEN", "RESOLVED_PLUS", "RESOLVED_MINUS", "WITHDRAWN"] },
    "scope":  { "$ref": "#/$defs/nonEmptyText" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "source_refs"],
      "properties": {
        "producer":    { "$ref": "#/$defs/nonEmptyText", "description": "Declared producer label. Not a platform-verified attribution." },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyText" } },
        "produced_at": { "type": "string", "description": "Optional. Never generated by this module." }
      }
    },
    "authority": { "const": false }
  },
  "$defs": {
    "nonEmptyText": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "note"],
      "properties": {
        "ref":  { "$ref": "#/$defs/nonEmptyText" },
        "note": { "type": "string" }
      }
    }
  }
}
